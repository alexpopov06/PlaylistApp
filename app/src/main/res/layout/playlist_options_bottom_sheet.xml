<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/handle_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/menuSheetCover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_cover_round_8"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            tools:src="@drawable/placeholdersvg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/menuSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_medium"
                android:maxLines="2"
                android:textColor="@color/black_white"
                android:textSize="16sp"
                tools:text="Best songs 2021" />

            <TextView
                android:id="@+id/menuSheetTrackCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/ColorTrackGroup"
                android:textSize="14sp"
                tools:text="98 треков" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/menuActionShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ys_display_medium"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/playlist_menu_share"
        android:textColor="@color/black_white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuActionEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ys_display_medium"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/playlist_menu_edit_info"
        android:textColor="@color/black_white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuActionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ys_display_medium"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/playlist_menu_delete_playlist"
        android:textColor="@color/black_white"
        android:textSize="16sp" />
</LinearLayout>
