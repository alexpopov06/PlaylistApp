<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/imageTrack"
        android:layout_width="@dimen/s45"
        android:layout_height="@dimen/s45"
        android:src="@drawable/image_track"
        android:layout_marginTop="8dp"
        android:paddingStart="5dp"
/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">
        <TextView
            android:id="@+id/nameTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Название"
            android:text="@dimen/s16"
            android:textColor="@color/ColorTrackName"
            android:paddingTop="@dimen/s14"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nameGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/ColorTrackGroup"
                tools:text="Группа" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textSize="10dp"
                android:layout_marginStart="@dimen/s5"
                android:layout_marginEnd="@dimen/s5"
                android:textColor="@color/ColorTrackGroup"/>
            <TextView
                android:id="@+id/trackTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1:00"
                android:textColor="@color/ColorTrackGroup"
                android:textSize="11dp"/>


        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:layout_width="@dimen/s24"
        android:layout_height="@dimen/s24"
        android:background="@android:color/transparent"
        app:icon="@drawable/strelka"
        app:iconTint="@color/ColorTrackGroup"
        android:layout_marginEnd="19dp"
        android:layout_gravity="center_vertical"/>


</LinearLayout>