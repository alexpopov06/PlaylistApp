<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foneSearch"
    tools:context=".player.ui.PlayerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="24dp"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="24dp"/>
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:tint="@color/black_white"
        android:backgroundTint="@color/foneSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/arrow_back"
/>
    <ImageView
        android:id="@+id/imageTrack"
        android:layout_marginTop="30dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/album"
        android:background="@drawable/rounded_corners"
        android:clipToOutline="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/leftBorder"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"
        app:layout_constraintBottom_toTopOf="@+id/guidelineForImage"
        />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineForImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"
        />

    <TextView
        android:id="@+id/TrackName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Yesterday (Remastered 2009)"
        android:textSize="@dimen/s24"
        android:textColor="@color/black_white"
        android:fontFamily="@font/ys_display_medium"
        android:layout_marginTop="@dimen/s24"
        app:layout_constraintStart_toEndOf="@id/leftBorder"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"
        app:layout_constraintTop_toBottomOf="@id/guidelineForImage"/>
    <TextView
        android:id="@+id/ArtistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="The Beatles"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="14dp"
        android:layout_marginTop="@dimen/s12"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/TrackName"
        app:layout_constraintStart_toEndOf="@id/leftBorder"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"/>
    <ImageView
        android:id="@+id/plusButton"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginTop="44dp"
        app:layout_constraintStart_toEndOf="@id/leftBorder"
        app:layout_constraintTop_toBottomOf="@id/ArtistName"
        app:layout_constraintEnd_toStartOf="@id/playButton"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:srcCompat="@drawable/plus_button"
        />
    <ImageView
        android:id="@+id/playButton"
        android:layout_width="83dp"
        android:layout_height="83dp"
        app:layout_constraintStart_toEndOf="@id/plusButton"
        app:layout_constraintEnd_toStartOf="@id/favButton"
        app:layout_constraintTop_toTopOf="@id/plusButton"
        app:layout_constraintBottom_toBottomOf="@id/plusButton"
        app:srcCompat="@drawable/play"/>
    <ImageView
        android:id="@+id/favButton"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"
        app:layout_constraintTop_toBottomOf="@id/ArtistName"
        app:layout_constraintStart_toEndOf="@id/playButton"
        app:srcCompat="@drawable/favbutton"/>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="00:00"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="@dimen/s14"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        app:layout_constraintStart_toEndOf="@id/leftBorder"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftBorder2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/s16"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightBorder2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/s16"/>
    <TextView
        android:id="@+id/longing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:textSize="13sp"
        android:textColor="@color/bottom_text_grey"
        android:text="Длительность"
        app:layout_constraintTop_toBottomOf="@id/plusButton"
        app:layout_constraintStart_toEndOf="@id/leftBorder2"
        app:layout_constraintBottom_toTopOf="@id/albom"
        />
    <TextView
        android:id="@+id/longing2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:textSize="13sp"
        android:text="5:35"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/plusButton"
        app:layout_constraintEnd_toStartOf="@id/rightBorder2"
        app:layout_constraintBottom_toTopOf="@id/albom2"
        />
    <TextView
        android:id="@+id/albom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/bottom_text_grey"
        android:text="Альбом"
        app:layout_constraintTop_toBottomOf="@id/longing"
        app:layout_constraintStart_toEndOf="@id/leftBorder2"
        app:layout_constraintBottom_toTopOf="@id/year"
        />
    <TextView
        android:id="@+id/albom2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:text="Yesterday (Remastered 2009)"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/longing2"
        app:layout_constraintEnd_toStartOf="@id/rightBorder"
        app:layout_constraintBottom_toTopOf="@id/year2"
        />
    <TextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/bottom_text_grey"
        android:text="Год"
        app:layout_constraintTop_toBottomOf="@id/albom"
        app:layout_constraintStart_toEndOf="@id/leftBorder2"
        app:layout_constraintBottom_toTopOf="@id/type"
        />
    <TextView
        android:id="@+id/year2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:text="1965"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/albom2"
        app:layout_constraintEnd_toStartOf="@id/rightBorder2"
        app:layout_constraintBottom_toTopOf="@id/type2"
        />
    <TextView
        android:id="@+id/type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/bottom_text_grey"
        android:text="Жанр"
        app:layout_constraintTop_toBottomOf="@id/year"
        app:layout_constraintStart_toEndOf="@id/leftBorder2"
        app:layout_constraintBottom_toTopOf="@id/country"
        />
    <TextView
        android:id="@+id/type2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:text="Rock"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/year2"
        app:layout_constraintEnd_toStartOf="@id/rightBorder2"
        app:layout_constraintBottom_toTopOf="@id/country2"
        />
    <TextView
        android:id="@+id/country"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/bottom_text_grey"
        android:text="Страна"
        app:layout_constraintTop_toBottomOf="@id/type"
        app:layout_constraintStart_toEndOf="@id/leftBorder2"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <TextView
        android:id="@+id/country2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:text="Великобритания"
        android:textColor="@color/black_white"
        app:layout_constraintTop_toBottomOf="@id/type2"
        app:layout_constraintEnd_toStartOf="@id/rightBorder2"
        app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_rounded_bg" />

        <TextView
            android:id="@+id/bottomSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ys_display_medium"
            android:text="Добавить в плейлист"
            android:textColor="@color/black_white"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newPlaylistButtonBottomSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Новый плейлист"
            android:textAllCaps="false"
            android:textColor="@color/white_black"
            android:fontFamily="@font/ys_display_medium"
            android:backgroundTint="@color/black_white"
            app:cornerRadius="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsBottomSheetRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_playlist_bottom_sheet" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>