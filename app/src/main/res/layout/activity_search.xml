<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/foneSearch"
    android:padding="@dimen/s8">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/s24"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:layout_marginStart="0dp"
            app:icon="@drawable/back"
            app:iconGravity="start"
            app:iconSize="@dimen/s24"
            app:iconTint="@color/colorOnSurface"
            />

        <TextView
            style="@style/TextCondition2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="@dimen/s22"
            android:layout_marginStart="-25dp"
            android:includeFontPadding="false"
            android:gravity="center_vertical"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/s16"
        android:paddingEnd="@dimen/s16">

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/edittext_rounded_bg"
            android:hint="@string/input_hint"
            android:textSize="@dimen/s16"
            android:maxLength="100"
            android:maxLines="1"
            android:inputType="text"
            android:textColor="@color/black"
            android:textColorHint="@color/InputHint"
            android:drawableStart="@drawable/lup"
            android:drawablePadding="@dimen/s8"
            android:paddingStart="@dimen/s12"
            android:drawableTint="@color/InputHint"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionDone"
            android:singleLine="true"/>

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/clear"
            android:color="@color/clearButtonColor"
            android:visibility="gone"
            android:padding="@dimen/s8" />
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecycleTracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_marginTop="@dimen/s24"/>
    <ImageView
        android:id="@+id/EmptyImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/nothingfind"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="102dp"/>
    <TextView
        android:id="@+id/EmptyText"
        android:layout_marginTop="@dimen/s16"
        android:text="Ничего не нашлось"
        style="@style/nowifitext"/>
    <ImageView
        android:id="@+id/NoWifiImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/nowifi"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="102dp"/>
    <TextView
        android:id="@+id/NoWifiText1"
        android:text="Проблема со связью"
        android:layout_marginTop="@dimen/s16"
        style="@style/nowifitext"/>
    <TextView
        android:id="@+id/NoWifiText2"
        android:text="Загрузка не удалась. Проверьте"
        android:layout_marginTop="@dimen/s16"
        style="@style/nowifitext"/>
    <TextView
        android:id="@+id/NoWifiText3"
        android:text="подключение к интернету"
        android:layout_marginTop="4dp"
        style="@style/nowifitext"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Обновить"
        android:textSize="@dimen/s14"
        app:cornerRadius="20dp"
        android:textColor="@color/obnovaColor"
        android:backgroundTint="@color/ColorNothingFind"
        android:layout_marginTop="24dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"/>

</LinearLayout>